# RentASeat Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# Frontend request prefix (used by src/api/client.ts)
# Local development: /api (routes through Vite dev proxy)
# Production: Set to CloudFront URL or API Gateway URL directly once CORS is configured
VITE_API_URL=/api

# Upstream API Gateway URL (used by Vite dev proxy in vite.config.ts)
# Local development proxy forwards /api/* to this endpoint
VITE_API_GATEWAY_URL=https://wmic9c9ilf.execute-api.ap-south-1.amazonaws.com
